---
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}

const { t } = Astro.props;

// Icons are language-independent; order matches t.about.cards.
const CARD_ICONS = [
  '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>',
  '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
  '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
];
---

<section class="section" id="about">
  <div class="container">
    <p class="kicker reveal">{t.about.kicker}</p>
    <h2 class="section-title gradient-text reveal">{t.about.title}</h2>
    <p class="section-lead reveal">{t.about.lead}</p>
    <p class="kicker kicker-sub reveal">{t.about.howKicker}</p>
    <div class="cards-3 reveal-group">
      {t.about.cards.map((card, i) => (
        <div class="card">
          <div class="icon-box" set:html={CARD_ICONS[i]}></div>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
