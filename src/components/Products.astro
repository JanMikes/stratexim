---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}

const { t } = Astro.props;

// Product photos are optimised at build time (WebP + srcset) by astro:assets.
const productImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/products/*.jpg',
  { eager: true }
);

// Each photo renders in a ~280px-wide 4:3 frame. Rendering at that size with a 2x
// density variant keeps both the `src` fallback and the `srcset` small — passing the
// full 1200px original would ship ~175kB per photo for a 280px slot.
const PHOTO_W = 280;
const PHOTO_H = 210;

// Segment icons + product photo filenames are language-independent.
// Order matches t.products.segments.
const SEG_META = [
  {
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
    photos: ['army-uniform.jpg', 'backpack.jpg'],
  },
  {
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>',
    photos: ['butcher-gloves.jpg', 'bags-cases.jpg'],
  },
  {
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"/></svg>',
    photos: ['mattress-protector.jpg', 'hospital-bedsheets.jpg'],
  },
  {
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>',
    photos: ['clothing-line.jpg', 'merch-hoodie.jpg'],
  },
  {
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M9 21v-6h6v6"/></svg>',
    photos: ['towels.jpg', 'bathrobe.jpg'],
  },
  {
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
    photos: ['protective-fabrics.jpg', 'membrane-fabrics.jpg'],
  },
];
---

<section class="section" id="products">
  <div class="container">
    <p class="kicker reveal">{t.products.kicker}</p>
    <h2 class="section-title gradient-text reveal">{t.products.title}</h2>
    <p class="section-lead reveal">{t.products.lead}</p>
    <div class="cards-2 reveal-group">
      {t.products.segments.map((seg, i) => (
        <div class="card seg-card">
          <div class="seg-head">
            <div class="icon-box" set:html={SEG_META[i].icon}></div>
            <h3>{seg.name}</h3>
          </div>
          <div class="seg-photos">
            {seg.photos.map((photo, j) => {
              const img = productImages[`/src/assets/images/products/${SEG_META[i].photos[j]}`].default;
              return (
                <figure>
                  <div class="frame">
                    <Image src={img} alt={photo.alt} width={PHOTO_W} height={PHOTO_H} densities={[1, 2]} loading="lazy" />
                  </div>
                  <figcaption><strong>{photo.title}</strong><span>{photo.desc}</span></figcaption>
                </figure>
              );
            })}
          </div>
          <p>{seg.blurb}</p>
          <ul class="chips">{seg.chips.map((chip) => <li>{chip}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>
