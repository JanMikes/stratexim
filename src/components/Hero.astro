---
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section class="hero" id="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-overlay"></div>
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="glow glow-3"></div>
    <div class="glow glow-4"></div>
    <div class="glow glow-5"></div>
  </div>
  <div class="hero-inner">
    <div class="hero-logo reveal">STRATEXIM</div>
    <div class="hero-underline reveal" aria-hidden="true"></div>
    <p class="hero-motto reveal">{t.hero.motto}</p>
    <div class="divider reveal" aria-hidden="true"></div>
    <h1 class="hero-title gradient-text reveal">{t.hero.title}</h1>
    <p class="hero-sub reveal">{t.hero.sub}</p>
    <a href="#contact" class="btn-pill btn-cta gradient-border reveal">{t.hero.cta}</a>
  </div>
  <a href="#about" class="hero-scroll" aria-label={t.hero.scrollAria}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </a>
</section>
