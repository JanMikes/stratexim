---
import { Image } from 'astro:assets';
import type { Translation } from '../i18n/translations';
import tomas from '../assets/images/team/tomas.jpg';
import myron from '../assets/images/team/myron.jpg';

interface Props {
  t: Translation;
}

const { t } = Astro.props;

// Names, roles, photos and alt text are language-independent; bios come from t.
const MEMBERS = [
  { photo: tomas, name: 'Tomáš Boniatti', role: 'CEO', alt: 'Tomáš Boniatti — CEO, Stratexim s.r.o.' },
  { photo: myron, name: 'Myron Mahurskyj', role: 'CTO', alt: 'Myron Mahurskyj — CTO, Stratexim s.r.o.' },
];
---

<section class="section" id="team">
  <div class="container">
    <p class="kicker reveal">{t.team.kicker}</p>
    <h2 class="section-title gradient-text reveal">{t.team.title}</h2>
    <p class="team-tagline reveal"><span class="line" aria-hidden="true"></span>{t.team.tagline}<span class="line" aria-hidden="true"></span></p>
    <div class="team-grid reveal-group">
      {MEMBERS.map((member, i) => (
        <div class="member">
          <div class="member-photo">
            <Image src={member.photo} alt={member.alt} width={170} height={170} densities={[1, 2]} loading="lazy" />
          </div>
          <h3>{member.name}</h3>
          <p class="member-role">{member.role}</p>
          <p class="member-bio">{t.team.bios[i]}</p>
        </div>
      ))}
    </div>
  </div>
</section>
