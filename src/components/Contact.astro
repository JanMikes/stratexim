---
import type { Lang, Translation } from '../i18n/translations';
import { LEGAL_PATH } from '../i18n/translations';

interface Props {
  t: Translation;
  lang: Lang;
}

const { t, lang } = Astro.props;
const c = t.contact;
const f = c.form;
const privacyHref = LEGAL_PATH[lang];
---

<section class="section" id="contact">
  <div class="container">
    <p class="kicker reveal">{c.kicker}</p>
    <h2 class="section-title gradient-text reveal">{c.title}</h2>
    <p class="section-lead reveal">{c.lead}</p>
    <form class="rfq-form reveal" id="rfqForm" action="https://formspree.io/f/xbdvwvqk" method="POST">
      <input type="hidden" name="language" value={f.languageValue} />
      <div class="form-row">
        <input type="text" name="company" placeholder={f.companyPh} aria-label={f.companyAria} required />
        <input type="email" name="email" placeholder={f.emailPh} aria-label={f.emailAria} required />
      </div>
      <div class="form-row">
        <select name="segment" aria-label={f.segmentAria} required>
          <option value="" disabled selected>{f.segmentPh}</option>
          {f.segmentOptions.map((opt) => <option>{opt}</option>)}
        </select>
        <input type="text" name="volume" placeholder={f.volumePh} aria-label={f.volumeAria} />
      </div>
      <textarea name="message" rows="5" placeholder={f.messagePh} aria-label={f.messageAria} required></textarea>
      <p class="form-note">{f.noteBefore}<a href={privacyHref}>{f.noteLink}</a>{f.noteAfter}</p>
      <button type="submit" class="btn-pill btn-cta gradient-border">{f.submit}</button>
      <p class="form-status" id="formStatus" data-ok={f.statusOk} data-err={f.statusErr}></p>
    </form>
    <p class="contact-or reveal">{c.or}</p>
    <a href="mailto:info@stratexim.com" class="btn-pill btn-mail gradient-border reveal">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      <span>info@stratexim.com</span>
      <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
    <a href="tel:+420776655106" class="btn-pill btn-mail gradient-border reveal btn-tel">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span>+420 776 655 106</span>
    </a>
    <p class="socials-intro reveal">{c.followIntro}</p>
    <a href="https://www.linkedin.com/company/stratexim/" class="btn-pill btn-mail gradient-border reveal btn-linkedin" target="_blank" rel="noopener" aria-label={c.linkedinAria}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
      <span>{c.followCta}</span>
      <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>
