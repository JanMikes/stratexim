---
import type { Lang, Translation } from '../i18n/translations';
import { HOME_PATH } from '../i18n/translations';

interface Props {
  t: Translation;
  lang: Lang;
}

const { t, lang } = Astro.props;
const langs: Lang[] = ['en', 'cz', 'de'];
const langLabels: Record<Lang, string> = { en: 'EN', cz: 'CZ', de: 'DE' };
---

<header class="nav" id="top">
  <div class="nav-inner">
    <a href="#hero" class="nav-logo">S T R A T E X I M</a>
    <nav class="nav-links" id="navLinks">
      <a href="#about">{t.nav.about}</a>
      <a href="#products">{t.nav.products}</a>
      <a href="#team">{t.nav.team}</a>
      <a href="#faq">{t.nav.faq}</a>
      <a href="#contact">{t.nav.contact}</a>
    </nav>
    <div class="nav-right">
      <div class="nav-lang">
        {langs.map((l, i) => (
          <Fragment>
            {i > 0 && <span class="lang-sep">/</span>}
            <a href={l === lang ? '#' : HOME_PATH[l]} class:list={['lang', { active: l === lang }]}>{langLabels[l]}</a>
          </Fragment>
        ))}
      </div>
      <button class="nav-burger" id="navBurger" aria-label={t.nav.menuAria}><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
