---
import type { Lang, Translation } from '../i18n/translations';
import { HOME_PATH, LEGAL_PATH } from '../i18n/translations';

interface Props {
  t: Translation;
  lang: Lang;
}

const { t, lang } = Astro.props;
const langs: Lang[] = ['en', 'cz', 'de'];
const langLabels: Record<Lang, string> = { en: 'EN', cz: 'CZ', de: 'DE' };
---

<!doctype html>
<html lang={t.htmlLang} data-lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.legal.metaTitle}</title>
    <meta name="description" content={t.legal.metaDescription} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#111827" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a href={HOME_PATH[lang]} class="nav-logo">S T R A T E X I M</a>
        <div class="nav-lang">
          {langs.map((l, i) => (
            <Fragment>
              {i > 0 && <span class="lang-sep">/</span>}
              <a href={LEGAL_PATH[l]} class:list={['lang', { active: l === lang }]}>{langLabels[l]}</a>
            </Fragment>
          ))}
        </div>
      </div>
    </header>

    <main class="legal-wrap">
      <a href={HOME_PATH[lang]} class="legal-back">{t.legal.back}</a>
      <div class="legal">
        <h1>{t.legal.heading}</h1>
        <p class="legal-updated">{t.legal.updated}</p>
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <span class="footer-logo">S T R A T E X I M</span>
        <span class="footer-copy">© <span id="year">2026</span> STRATEXIM s.r.o. {t.footer.rights}</span>
        <span class="footer-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <div class="footer-company">{t.footer.companyText}</div>
    </footer>

    <script>
      const yearEl = document.getElementById('year');
      if (yearEl) yearEl.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
